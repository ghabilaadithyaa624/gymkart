# GymKart Environment Variables
# Copy this file to .env.local and update the values

# ─── Database ──────────────────────────────────────────────────────────
# Your PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymkart

# ─── Auth ──────────────────────────────────────────────────────────────
# Random secret used to sign JWT session tokens
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-secret-in-production

# ─── Node Environment ──────────────────────────────────────────────────
# NODE_ENV=production  # Uncomment for production builds
